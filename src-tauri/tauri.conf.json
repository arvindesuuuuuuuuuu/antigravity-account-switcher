{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antigravity Account Switcher",
  "version": "1.0.0",
  "identifier": "com.antigravity.accountswitcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Antigravity Account Switcher",
        "width": 560,
        "height": 720,
        "minWidth": 460,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' https://lh3.googleusercontent.com; img-src 'self' data: https://lh3.googleusercontent.com https://*.googleusercontent.com; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon32.png",
      "icons/icon64.png",
      "icons/icon128.png",
      "icons/icon256.png",
      "icons/icon512.png"
    ]
  }
}
